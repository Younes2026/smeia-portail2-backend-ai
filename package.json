{
  "name": "smeia-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated backend service for the SMEIA AI assistant.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/domain/ai-diagnostic/ai-diagnostic.schema.test.ts src/domain/ai-booking/ai-booking.schema.test.ts src/domain/ai-booking/ai-booking.availability.test.ts src/application/ai-diagnostic/ai-diagnostic.service.test.ts src/application/ai-diagnostic/analyze-ai-diagnostic.use-case.test.ts src/application/ai-booking/search-appointment-availability.use-case.test.ts src/infrastructure/directus/directus-http-client.test.ts src/infrastructure/directus/directus-catalog.service.test.ts src/infrastructure/directus/directus-vehicle-context.service.test.ts src/infrastructure/directus/directus-booking-availability.service.test.ts src/middleware/ai-rate-limit.test.ts src/routes/ai-diagnostic.routes.test.ts src/routes/ai-booking.routes.test.ts",
    "test:directus:live": "tsx scripts/test-directus-catalog-live.ts",
    "test:ai-endpoint:image:live": "tsx scripts/test-ai-diagnostic-endpoint-image-live.ts",
    "test:ai-endpoint:live": "tsx scripts/test-ai-diagnostic-endpoint-live.ts",
    "test:ai-booking:availability:live": "tsx scripts/test-ai-booking-availability-live.ts",
    "test:ai:image:live": "tsx scripts/test-ai-diagnostic-image-live.ts",
    "test:ai:live": "tsx scripts/test-ai-diagnostic-live.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
