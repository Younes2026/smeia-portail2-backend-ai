{
  "name": "smeia-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated backend service for the SMEIA AI assistant.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/domain/ai-diagnostic/ai-diagnostic.schema.test.ts src/application/ai-diagnostic/ai-diagnostic.service.test.ts",
    "test:ai:live": "tsx scripts/test-ai-diagnostic-live.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
